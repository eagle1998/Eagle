# =========================================================
# VITE API BASE URL
# =========================================================
# LOCAL DEVELOPMENT:
#   Leave unset — the Vite dev server proxies /api and /uploads
#   to the backend at http://localhost:5000 (see vite.config.js).
#
# PRODUCTION (Vercel):
#   Set this in Vercel → Project → Settings → Environment Variables
#   to the deployed backend URL, e.g.:
#   VITE_API_BASE_URL=https://eagle-shop-api.vercel.app/api
#
# The app falls back to '/api' (same-origin) when unset.
# =========================================================
VITE_API_BASE_URL=
