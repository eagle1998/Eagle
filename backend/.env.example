PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (use mongodb+srv:// or direct hosts)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT secret — MUST be at least 32 characters in production
JWT_SECRET=change_to_min_32_char_random_string_openssl_rand_hex_32
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Vercel Blob token (required on Vercel for image uploads).
# Create it: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

MAX_UPLOAD_SIZE=5242880
UPLOAD_PATH=uploads

# Secret required to register new admins (/api/auth/register)
ADMIN_REGISTER_SECRET=replace_with_a_long_random_secret_key
