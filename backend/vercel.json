{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "echo \"No build required\"",
  "installCommand": "npm install --omit=dev || npm install",
  "functions": {
    "server.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "config/**,controllers/**,middleware/**,models/**,routes/**,services/**,utils/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}